# SourceTube configuration
PORT=8787
APP_ORIGIN=http://localhost:8787

# FreeTube-compatible Invidious instance used for public metadata.
# Separate multiple instances with commas; SourceTube tries them in order.
INVIDIOUS_INSTANCE=https://yt.chocolatemoo53.com

# Google OAuth client. Create one in Google Cloud, type "Web application".
# Authorized redirect URI must equal GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/callback

# Optional fallback for signed-in subscription metadata.
YOUTUBE_API_KEY=

# Set to a long random string so encrypted session cookies survive restarts.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional. Set to 1 to fail instead of trying the next free port.
STRICT_PORT=
