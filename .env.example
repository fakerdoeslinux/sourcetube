# SourceTube configuration
PORT=8787
APP_ORIGIN=http://localhost:8787

# YouTube Data API v3 key, used for public metadata.
YOUTUBE_API_KEY=

# Google OAuth client. Create one in Google Cloud, type "Web application".
# Authorized redirect URI must equal GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/callback

# Set to a long random string in production so encrypted session cookies
# survive restarts. Generate with: openssl rand -base64 48
SESSION_SECRET=
